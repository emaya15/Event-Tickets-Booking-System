# ---------- Application ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- MySQL (SQLAlchemy URL) ----------
# Create the database first:  CREATE DATABASE ticket_booking CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://ticket_user:change-me@localhost:3306/ticket_booking

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Secrets (generate long random values!) ----------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
QR_SIGNING_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- Initial Admin (created at startup if it does not exist) ----------
# Leave blank to skip. Use a strong password and change it after first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin
ADMIN_PHONE=9000000000

# ---------- SMTP (leave SMTP_HOST empty to use MOCK email logging) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tickets@example.com
SMTP_USE_TLS=true

# ---------- Scheduler ----------
# Set to false on API workers and true on exactly one dedicated process
# (python -m app.jobs.run_scheduler) when running several workers.
RUN_SCHEDULER=true

# ---------- Rate limits (requests per window) ----------
LOCK_RATE_LIMIT=5
LOGIN_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- Business rules ----------
DYNAMIC_PRICING_ENABLED=true

# ---------- Razorpay (optional, TEST mode keys only) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
